      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nif (!body.external_request_id || typeof body.external_request_id !== 'string') {\n  throw new Error('external_request_id (string) is required');\n}\nif (!body.warehouse_code || typeof body.warehouse_code !== 'string') {\n  throw new Error('warehouse_code (string) is required');\n}\nif (!Array.isArray(body.items) || body.items.length === 0) {\n  throw new Error('items must be a non-empty array');\n}\nconst items = body.items.map((item, index) => {\n  if (!item.sku || typeof item.sku !== 'string') throw new Error(`items[${index}].sku is required`);\n  const qty = Number(item.requested_quantity);\n  if (!Number.isInteger(qty) || qty <= 0) throw new Error(`items[${index}].requested_quantity must be a positive integer`);\n  return { sku: item.sku.trim(), requested_quantity: qty };\n});\nreturn [{ json: {\n  external_request_id: body.external_request_id.trim(),\n  warehouse_code: body.warehouse_code.trim(),\n  requested_by: body.requested_by ?? 'website',\n  notes: body.notes ?? null,\n  items\n} }];"
      },
